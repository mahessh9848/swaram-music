# ══════════════════════════════════════════════════════════════════
# SWARAM Frontend — .gitignore
# (Root .gitignore also applies — this adds frontend-specific rules)
# ══════════════════════════════════════════════════════════════════

# ─── Build outputs ────────────────────────────────────────────────
dist/
dist-ssr/

# ─── Node.js ──────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.local

# ─── Environment (secrets) ────────────────────────────────────────
.env
.env.*
!.env.example

# ─── Editor ───────────────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store

# ─── OS ───────────────────────────────────────────────────────────
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
Thumbs.db

# ─── Vite cache ───────────────────────────────────────────────────
.vite/
