# ══════════════════════════════════════════════════════════════════
# SWARAM — Git Attributes (.gitattributes)
#
# Audio files are tracked as regular binary files so static assets
# deploy seamlessly to Vercel and other cloud platforms without
# requiring external Git LFS pull steps.
# ══════════════════════════════════════════════════════════════════

# Audio files — standard Git binary
*.mp3  binary
*.wav  binary
*.flac binary
*.ogg  binary
*.aac  binary
*.m4a  binary

# Text files — normalize line endings to LF on commit
*.js    text eol=lf
*.jsx   text eol=lf
*.ts    text eol=lf
*.tsx   text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.sql   text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.sh    text eol=lf
*.env.example text eol=lf

# Binary media & fonts — do not mangle
*.ico   binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.svg   text eol=lf
*.webp  binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.eot   binary
*.psd   binary
*.ai    binary
*.sketch binary
