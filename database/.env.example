# ====================================================================
# SWARAM BACKEND ENVIRONMENT CONFIGURATION (EXAMPLE)
# Copy this file to .env in your Express/Node.js backend folder.
# DO NOT COMMIT THE ACTUAL .env FILE CONTAINING SENSITIVE CREDENTIALS.
# ====================================================================

PORT=5000
NODE_ENV=development

# Oracle Database Connection via node-oracledb
ORACLE_USER=scott
ORACLE_PASSWORD=tiger
ORACLE_CONNECT_STRING=localhost:1521/orcl1

# Optional Connection Pool Settings
ORACLE_POOL_MIN=2
ORACLE_POOL_MAX=10
ORACLE_POOL_INCREMENT=2
ORACLE_POOL_TIMEOUT=60

# JWT Authentication Secret
JWT_SECRET=swaram_super_secret_jwt_key_2026_dev_only
JWT_EXPIRATION=7d
